# Copy to .env and fill in real values. Real keys never go in git (.env is ignored).

# ---- backend ------------------------------------------------------------------------
# Comma-separated key pool, at least 2. Ids are key_1, key_2, ... in this order.
# Tip: Gemini quotas are per Google Cloud project, not per key, so create the keys in two
# different projects (or accounts) if you want failover to help against real rate limits.
LLM_API_KEYS=replace-with-first-api-key,replace-with-second-api-key

# Any LiteLLM model name. Must match the provider your keys belong to.
LLM_MODEL=gemini/gemini-3.1-flash-lite

# SQLite location. In Docker this sits on the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db

# Comma-separated browser origins allowed to call the API (or * for any).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# true enables the X-Simulate-Failure test header. Required to be true on the deployed demo.
ENABLE_FAILURE_SIMULATION=true

# ---- optional backend tuning (defaults shown) -----------------------------------------
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
CACHE_TTL_SECONDS=3600
LLM_TIMEOUT_SECONDS=30
KEY_COOLDOWN_SECONDS=30
MAX_HISTORY_MESSAGES=40
LOG_LEVEL=INFO

# ---- frontend (Docker) ------------------------------------------------------------------
# URL the browser uses to reach the backend. Without Docker, set VITE_API_URL instead.
API_URL=http://localhost:8000
